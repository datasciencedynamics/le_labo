# Data: nothing under data/ is tracked except .gitkeep placeholders
data/**
!data/*/
!data/*/.gitkeep

# Model outputs and reports: keep folders only
models/**
!models/*/
!models/*/.gitkeep
reports/**
!reports/.gitkeep
catboost_info/

# Data files anywhere in the repo
*.csv
*.tsv
*.json
*.geojson
*.parquet
*.pkl
*.xlsx
*.zip
*.html
!core/templates/report_template.html

# Python / environment
lelabo_venv/
.venv/
__pycache__/
*.py[co]
*.egg-info/
.ipynb_checkpoints/

# MLflow tracking data
mlruns/
mlartifacts/
