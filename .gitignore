# Data: nothing under data/ is tracked except .gitkeep placeholders
data/**
!data/*/
!data/*/.gitkeep

# Model outputs and reports: keep folders only
models/**
!models/*/
!models/*/.gitkeep
reports/**
!reports/.gitkeep

# Data files anywhere in the repo
*.csv
*.tsv
*.json
*.geojson
*.parquet
*.pkl
*.xlsx
*.zip

# Python / environment
le_labo_venv/
.env
.venv
env/
venv/
*venv/
**venv**/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[co]
*.egg-info/
.ipynb_checkpoints/
