# Data: nothing under data/ is tracked except .gitkeep placeholders
data/**
!data/*/
!data/*/.gitkeep

# Model outputs and reports: keep folders only
models/**
!models/*/
!models/*/.gitkeep
reports/**
!reports/.gitkeep

# Data files anywhere in the repo
*.csv
*.tsv
*.json
*.geojson
*.parquet
*.pkl
*.xlsx
*.zip

# Python / environment
lelabo_venv/
.venv/
__pycache__/
*.py[co]
*.egg-info/
.ipynb_checkpoints/
